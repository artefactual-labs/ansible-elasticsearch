# ======================== Elasticsearch Configuration =========================
#
# NOTE: Elasticsearch comes with reasonable defaults for most settings.
#       Before you set out to tweak and tune the configuration, make sure you
#       understand what are you trying to accomplish and the consequences.
#
# The primary way of configuring a node is via this file. This template lists
# the most important settings you may want to configure for a production cluster.
#
# Please consult the documentation for further information on configuration options:
# https://www.elastic.co/guide/en/elasticsearch/reference/index.html
#
# ---------------------------------- Cluster -----------------------------------
#
# Use a descriptive name for your cluster:
#
#cluster.name: my-application
{% if elasticsearch_cluster_name is defined %}
cluster.name: {{ elasticsearch_cluster_name }}
{% endif %}
#
# ------------------------------------ Node ------------------------------------
#
# Use a descriptive name for the node:
#
#node.name: node-1
{% if elasticsearch_node_name is defined %}
node.name: {{ elasticsearch_node_name }}
{% endif %}
#
# Add custom attributes to the node:
#
#node.attr.rack: r1
{% if elasticsearch_node_rack is defined %}
node.attr.rack: {{ elasticsearch_node_rack }}
{% endif %}
#
# ----------------------------------- Paths ------------------------------------
#
# Path to directory where to store the data (separate multiple locations by comma):
#
#path.data: /path/to/data
{% if elasticsearch_data_dir is defined %}
path.data: {{ elasticsearch_data_dir }}
{% endif %}
#
# Path to log files:
#
#path.logs: /path/to/logs
{% if elasticsearch_log_dir is defined %}
path.logs: {{ elasticsearch_log_dir }}
{% endif %}
#
# ----------------------------------- Memory -----------------------------------
#
# Lock the memory on startup:
#
#bootstrap.memory_lock: true
{% if elasticsearch_memory_bootstrap_mlockall is defined %}
bootstrap.memory_lock: {{ elasticsearch_memory_bootstrap_mlockall }}
{% endif %}
#
# Make sure that the heap size is set to about half the memory available
# on the system and that the owner of the process is allowed to use this
# limit.
#
# Elasticsearch performs poorly when the system is swapping the memory.
#
# ---------------------------------- Network -----------------------------------
#
# By default Elasticsearch is only accessible on localhost. Set a different
# address here to expose this node on the network:
#
#network.host: 192.168.0.1
{% if elasticsearch_network_host is defined %}
network.host: {{ elasticsearch_network_host }}
{% endif %}
#
# By default Elasticsearch listens for HTTP traffic on the first free port it
# finds starting at 9200. Set a specific HTTP port here:
#
#http.port: 9200
{% if elasticsearch_network_http_port is defined %}
http.port: {{ elasticsearch_network_http_port }}
{% endif %}
#
# For more information, consult the network module documentation.
#
# --------------------------------- Discovery ----------------------------------
#
# Pass an initial list of hosts to perform discovery when this node is started:
# The default list of hosts is ["127.0.0.1", "[::1]"]
#
#discovery.seed_hosts: ["host1", "host2"]
{% if elasticsearch_discovery_seed_hosts is defined %}
discovery.seed_hosts: {{ elasticsearch_discovery_seed_hosts }}
{% endif %}
#
# Bootstrap the cluster using an initial set of master-eligible nodes:
#
#cluster.initial_master_nodes: ["node-1", "node-2"]
{% if elasticsearch_cluster_initial_master_nodes is defined %}
cluster.initial_master_nodes: {{ elasticsearch_cluster_initial_master_nodes }}
{% endif %}
#
# For more information, consult the discovery and cluster formation module documentation.
#
# ---------------------------------- Various -----------------------------------
#
# Allow wildcard deletion of indices:
#
#action.destructive_requires_name: false
{% if elasticsearch_action_destructive_requires_name is defined %}
action.destructive_requires_name: {{ elasticsearch_action_destructive_requires_name }}
{% endif %}

#----------------------- BEGIN SECURITY AUTO CONFIGURATION -----------------------
#
# The following settings, TLS certificates, and keys have been automatically      
# generated to configure Elasticsearch security features on {{ ansible_date_time.date }}
#
# --------------------------------------------------------------------------------

# Enable security features
{% if elasticsearch_xpack_security_enabled is defined %}
xpack.security.enabled: {{ elasticsearch_xpack_security_enabled }}
{% else %}
xpack.security.enabled: false
{% endif %}

{% if elasticsearch_xpack_security_enrollment_enabled is defined %}
xpack.security.enrollment.enabled: {{ elasticsearch_xpack_security_enrollment_enabled }}
{% else %}
xpack.security.enrollment.enabled: false
{% endif %}

# Enable encryption for HTTP API client connections, such as Kibana, Logstash, and Agents
{% if elasticsearch_xpack_security_http_ssl_enabled is defined %}
xpack.security.http.ssl:
  enabled: {{ elasticsearch_xpack_security_http_ssl_enabled }}
  {% if elasticsearch_xpack_security_http_ssl_keystore_path is defined %}
  keystore.path: {{ elasticsearch_xpack_security_http_ssl_keystore_path }}
  {% endif %}
{% else %}
xpack.security.http.ssl:
  enabled: false
{% endif %}

# Enable encryption and mutual authentication between cluster nodes
{% if elasticsearch_xpack_security_transport_ssl_enabled is defined %}
xpack.security.transport.ssl:
  enabled: {{ elasticsearch_xpack_security_transport_ssl_enabled }}
  verification_mode: {{ elasticsearch_xpack_security_transport_ssl_verification_mode | default('certificate') }}
  {% if elasticsearch_xpack_security_transport_ssl_keystore_path is defined %}
  keystore.path: {{ elasticsearch_xpack_security_transport_ssl_keystore_path }}
  {% endif %}
  {% if elasticsearch_xpack_security_transport_ssl_truststore_path is defined %}
  truststore.path: {{ elasticsearch_xpack_security_transport_ssl_truststore_path }}
  {% endif %}
{% else %}
xpack.security.transport.ssl:
  enabled: false
{% endif %}
#----------------------- END SECURITY AUTO CONFIGURATION -------------------------

# ---------------------------------- Gateway -----------------------------------
#
# Block initial recovery after a full cluster restart until N nodes are started:
#
#gateway.recover_after_nodes: 3
{% if elasticsearch_gateway_recover_after_nodes is defined %}
gateway.recover_after_nodes: {{ elasticsearch_gateway_recover_after_nodes }}
{% endif %}
#
# For more information, consult the gateway module documentation.
#
# ---------------------------------- Various -----------------------------------
#
# Require explicit names when deleting indices:
#
#action.destructive_requires_name: true
{% if elasticsearch_action_destructive_requires_name is defined %}
action.destructive_requires_name: {{ elasticsearch_action_destructive_requires_name }}
{% endif %}

# ---------------------------------- Remote clusters ---------------------------
#
# Remote clusters for cross-cluster search and replication
#
{% if elasticsearch_remote_clusters is defined %}
cluster.remote:
{% for cluster in elasticsearch_remote_clusters %}
  {{ cluster.name }}:
    seeds: {{ cluster.seeds }}
    {% if cluster.skip_unavailable is defined %}
    skip_unavailable: {{ cluster.skip_unavailable }}
    {% endif %}
{% endfor %}
{% endif %}

# ---------------------------------- Snapshot repositories ---------------------
#
# Snapshot repository settings
#
{% if elasticsearch_snapshot_repo_path is defined %}
path.repo: {{ elasticsearch_snapshot_repo_path }}
{% endif %}

# ---------------------------------- Thread pools ------------------------------
#
# Thread pool settings
#
{% if elasticsearch_thread_pools is defined %}
{% for threadPoolSetting in elasticsearch_thread_pools %}
{{ threadPoolSetting }}
{% endfor %}
{% endif %}

# ---------------------------------- Monitoring --------------------------------
#
# Enable or disable monitoring features
#
{% if elasticsearch_xpack_monitoring_enabled is defined %}
xpack.monitoring.enabled: {{ elasticsearch_xpack_monitoring_enabled }}
{% endif %}

{% if elasticsearch_xpack_monitoring_collection_enabled is defined %}
xpack.monitoring.collection.enabled: {{ elasticsearch_xpack_monitoring_collection_enabled }}
{% endif %}

# ---------------------------------- License -----------------------------------
#
# License settings
#
{% if elasticsearch_xpack_license_self_generated_type is defined %}
xpack.license.self_generated.type: {{ elasticsearch_xpack_license_self_generated_type }}
{% endif %}

# ---------------------------------- Machine Learning --------------------------
#
# Machine learning settings
#
{% if elasticsearch_xpack_ml_enabled is defined %}
xpack.ml.enabled: {{ elasticsearch_xpack_ml_enabled }}
{% endif %}

# ---------------------------------- Watcher -----------------------------------
#
# Watcher settings
#
{% if elasticsearch_xpack_watcher_enabled is defined %}
xpack.watcher.enabled: {{ elasticsearch_xpack_watcher_enabled }}
{% endif %}

# ---------------------------------- HTTP --------------------------------------
#
# HTTP settings
#
{% if elasticsearch_http_cors_enabled is defined %}
http.cors.enabled: {{ elasticsearch_http_cors_enabled }}
{% if elasticsearch_http_cors_allow_origin is defined %}
http.cors.allow-origin: "{{ elasticsearch_http_cors_allow_origin }}"
{% endif %}
{% if elasticsearch_http_cors_allow_headers is defined %}
http.cors.allow-headers: "{{ elasticsearch_http_cors_allow_headers }}"
{% endif %}
{% endif %}

{% if elasticsearch_http_max_content_length is defined %}
http.max_content_length: {{ elasticsearch_http_max_content_length }}
{% endif %}

# ---------------------------------- Indices -----------------------------------
#
# Index settings
#
{% if elasticsearch_indices_recovery_max_bytes_per_sec is defined %}
indices.recovery.max_bytes_per_sec: {{ elasticsearch_indices_recovery_max_bytes_per_sec }}
{% endif %}

{% if elasticsearch_indices_memory_index_buffer_size is defined %}
indices.memory.index_buffer_size: {{ elasticsearch_indices_memory_index_buffer_size }}
{% endif %}

# ---------------------------------- Cluster Routing ---------------------------
#
# Cluster routing settings
#
{% if elasticsearch_cluster_routing_allocation_node_concurrent_recoveries is defined %}
cluster.routing.allocation.node_concurrent_recoveries: {{ elasticsearch_cluster_routing_allocation_node_concurrent_recoveries }}
{% endif %}

{% if elasticsearch_cluster_routing_allocation_disk_threshold_enabled is defined %}
cluster.routing.allocation.disk.threshold_enabled: {{ elasticsearch_cluster_routing_allocation_disk_threshold_enabled }}
{% endif %}

{% if elasticsearch_cluster_routing_allocation_disk_watermark_low is defined %}
cluster.routing.allocation.disk.watermark.low: {{ elasticsearch_cluster_routing_allocation_disk_watermark_low }}
{% endif %}

{% if elasticsearch_cluster_routing_allocation_disk_watermark_high is defined %}
cluster.routing.allocation.disk.watermark.high: {{ elasticsearch_cluster_routing_allocation_disk_watermark_high }}
{% endif %}

{% if elasticsearch_cluster_routing_allocation_disk_watermark_flood_stage is defined %}
cluster.routing.allocation.disk.watermark.flood_stage: {{ elasticsearch_cluster_routing_allocation_disk_watermark_flood_stage }}
{% endif %}

# ---------------------------------- Node Roles --------------------------------
#
# Node roles (for Elasticsearch 7.9+)
#
{% if elasticsearch_node_roles is defined %}
node.roles: {{ elasticsearch_node_roles }}
{% endif %}

# ---------------------------------- Ingest ------------------------------------
#
# Ingest settings
#
{% if elasticsearch_ingest_geoip_downloader_enabled is defined %}
ingest.geoip.downloader.enabled: {{ elasticsearch_ingest_geoip_downloader_enabled }}
{% endif %}

# ---------------------------------- Reindex -----------------------------------
#
# Reindex settings
#
{% if elasticsearch_reindex_remote_whitelist is defined %}
reindex.remote.whitelist: {{ elasticsearch_reindex_remote_whitelist }}
{% endif %}

# ---------------------------------- Script ------------------------------------
#
# Script settings
#
{% if elasticsearch_script_allowed_types is defined %}
script.allowed_types: {{ elasticsearch_script_allowed_types }}
{% endif %}

{% if elasticsearch_script_allowed_contexts is defined %}
script.allowed_contexts: {{ elasticsearch_script_allowed_contexts }}
{% endif %}
